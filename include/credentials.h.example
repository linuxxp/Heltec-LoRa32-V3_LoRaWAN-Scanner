#ifndef CREDENTIALS_H
#define CREDENTIALS_H

// =============================================================================
// LORAWAN OTAA CREDENTIALS
// =============================================================================
// Get these from your Helium Console after registering the device
// https://console.helium.com/
//
// IMPORTANT: Copy this file to credentials.h and fill in your values
// DO NOT commit credentials.h to version control!

// Device EUI (8 bytes, LSB first)
// Example: If console shows 6081F9A2B3C4D5E6, enter in reverse order
static const uint8_t DEVEUI[8] = { 0xE6, 0xD5, 0xC4, 0xB3, 0xA2, 0xF9, 0x81, 0x60 };

// Application EUI / Join EUI (8 bytes, LSB first)
// For Helium, this is usually all zeros or provided by console
static const uint8_t APPEUI[8] = { 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00 };

// Application Key (16 bytes, MSB - keep as shown in console)
static const uint8_t APPKEY[16] = {
    0x00, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77,
    0x88, 0x99, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0xFF
};

// =============================================================================
// HOW TO GET CREDENTIALS FROM HELIUM CONSOLE
// =============================================================================
/*
1. Go to https://console.helium.com/
2. Create a new device or select existing
3. Copy the credentials:
   - Device EUI: Copy and reverse byte order (LSB first)
   - App EUI: Usually 0000000000000000 for Helium
   - App Key: Copy as-is (MSB first)

Example conversion for Device EUI:
   Console shows: 6081F9A2B3C4D5E6
   Split into bytes: 60 81 F9 A2 B3 C4 D5 E6
   Reverse order: E6 D5 C4 B3 A2 F9 81 60
   Result: { 0xE6, 0xD5, 0xC4, 0xB3, 0xA2, 0xF9, 0x81, 0x60 }
*/

#endif // CREDENTIALS_H
